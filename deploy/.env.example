# 서버의 deploy/.env 로 복사해서 값을 채운다 (git에 올리지 않음)

# 도메인 (카페24 DNS에 A 레코드로 서버 IP를 연결)
SHOP_DOMAIN=ddgorae.ksaria.co.kr
ADMIN_DOMAIN=ddgorae-admin.ksaria.co.kr

# DB 비밀번호: openssl rand -base64 24
DB_PASSWORD=

# 개인정보 암호화 키 (32바이트 base64): openssl rand -base64 32
# 한 번 정하면 바꾸지 않는다. 잃어버리면 저장된 연락처·주소를 복구할 수 없다.
FIELD_ENCRYPTION_KEY=

# 최초 관리자 계정 (계정이 없을 때만 생성, 비밀번호 10자 이상)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 토스페이먼츠 결제위젯 키 (테스트 서버는 test_gck_ / test_gsk_)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 결제 수단. 기본은 무통장입금만 받는다 (토스 키가 있어도 CARD_PAYMENT_ENABLED=true 일 때만 카드 결제를 연다)
CARD_PAYMENT_ENABLED=false
# 무통장입금 계좌 (비우면 기본값: 기업은행 478-083872-04-017 (주)케이에스에이솔루션)
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_HOLDER=
# 주문 후 이 시간 안에 입금이 없으면 자동 취소 (기본 48)
BANK_DEPOSIT_HOURS=

# 알림 메일 SMTP (새 무통장 주문·입금 확인·입금 기한 임박). MAIL_HOST를 비우면 메일을 보내지 않는다
# 예) Gmail: smtp.gmail.com / 587 / 계정 / 앱 비밀번호,  네이버웍스: smtp.worksmobile.com / 587
#     다음: smtp.daum.net / 465 / MAIL_SSL=true, MAIL_STARTTLS=false / MAIL_FROM=아이디@daum.net
MAIL_HOST=
MAIL_PORT=587
MAIL_SSL=false
MAIL_STARTTLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
# 보내는 사람 (비우면 MAIL_USERNAME)
MAIL_FROM=
# 운영자 알림 받을 메일 (기본 kmh@ksas.co.kr)
NOTIFY_ADMIN_EMAIL=

# 사진으로 상품 정보 자동 입력 (Claude API). https://console.anthropic.com 에서 발급. 비우면 기능이 꺼진다
ANTHROPIC_API_KEY=

# 간편로그인 (비워 두면 로그인 화면에 '준비중'으로 표시). 발급 방법은 README의 '간편로그인' 참고
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
