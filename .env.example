# API 서버 (apps/api) - 기본값은 docker-compose.yml 로컬 환경
DB_URL=jdbc:postgresql://localhost:5433/aishop
DB_USERNAME=aishop
DB_PASSWORD=aishop
REDIS_HOST=localhost
REDIS_PORT=6379
SLOW_QUERY_THRESHOLD_MS=200

# 로그인 세션
SESSION_TIMEOUT=12h
# 운영(HTTPS)에서는 true
SESSION_COOKIE_SECURE=false

# 최초 관리자 계정. 이 이메일 계정이 없을 때만 서버 시작 시 만든다 (비밀번호 10자 이상)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 토스페이먼츠 결제위젯 키 (개발자센터 > API 키). 테스트 키는 test_gck_ / test_gsk_ 로 시작한다.
# 시크릿 키는 API 서버에만 둔다. 두 값이 모두 있어야 결제 버튼이 열린다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 결제 수단. 기본은 무통장입금만 받는다 (토스 키가 있어도 CARD_PAYMENT_ENABLED=true 일 때만 카드 결제를 연다)
CARD_PAYMENT_ENABLED=false
# 무통장입금 계좌 (비우면 기본값: 기업은행 478-083872-04-017 (주)케이에스에이솔루션)
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_HOLDER=
# 주문 후 이 시간 안에 입금이 없으면 자동 취소 (기본 48)
BANK_DEPOSIT_HOURS=

# 개인정보(수령인 연락처·주소) 암호화 키: 32바이트를 base64로 인코딩한 값
# 만들기: openssl rand -base64 32   (운영에서 한 번 정하면 바꾸지 않는다)
FIELD_ENCRYPTION_KEY=
